{
  "name": "jsx-backend",
  "version": "0.1.0",
  "description": "Express-like HTTP server using React/JSX semantics with a custom reconciler",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/example.tsx",
    "start": "tsx src/example.tsx",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "react",
    "jsx",
    "express",
    "http",
    "reconciler"
  ],
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "react": "^18.2.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  }
}
