{
  "name": "strict-jsx",
  "version": "1.0.0",
  "description": "TypeScript transformer and language service plugin that preserves literal types in JSX",
  "author": "poteat",
  "license": "MIT",
  "repository": {
    "type": "git",
    "directory": "packages/strict-jsx"
  },
  "main": "./index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./index.js"
    }
  },
  "files": [
    "dist",
    "index.js"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "typescript",
    "transformer",
    "jsx",
    "ts-patch",
    "literal-types",
    "type-safety"
  ],
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.7.0",
    "vitest": "^4.0.17"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  }
}
